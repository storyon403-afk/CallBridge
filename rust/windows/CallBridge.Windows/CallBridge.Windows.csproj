<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>CallBridge</AssemblyName>
    <Version>0.0.5</Version>
    <AssemblyVersion>0.0.5.51</AssemblyVersion>
    <FileVersion>0.0.5.51</FileVersion>
    <ApplicationIcon>CallBridge.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- 构图缩略图和运行时读取同一份随包素材，两种 Windows 打包入口均由 publish 复制。 -->
    <Content Include="../../../prototypes/call-workspace/media/coast-evening.jpg;../../../prototypes/call-workspace/media/window-morning.jpg;../../native/studio/cheng.png" Link="studio/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Resource Include="CallBridge.ico" />
    <Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
</Project>
