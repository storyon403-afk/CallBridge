<Window x:Class="CallBridge.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="CallBridge 主面板" Width="400" Height="360" MinWidth="180" MinHeight="96">
  <DockPanel Margin="16,4,16,10">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="文字 ↗" Click="OpenText" HorizontalAlignment="Left"/>
      <ComboBox Grid.Column="1" x:Name="Material" MinWidth="128" Margin="0" SelectionChanged="MaterialChanged" AutomationProperties.Name="面板背景"><ComboBoxItem Content="实色背景"/><ComboBoxItem Content="半透明背景"/></ComboBox>
    </Grid>
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Status" Style="{StaticResource Caption}" Text="未采集麦克风" MaxHeight="30" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Click="StopAll" Width="32" ToolTip="停止全部" AutomationProperties.Name="停止全部"><Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource InkBrush}"/></Button>
    </Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="Modules"/></ScrollViewer>
  </DockPanel>
</Window>
