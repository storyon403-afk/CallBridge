<Window x:Class="CallBridge.Windows.VisualWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Style="{StaticResource {x:Type Window}}" Title="运行画面" Width="400" Height="360" MinWidth="320" MinHeight="300">
  <DockPanel Margin="12,4,12,8">
    <TextBlock DockPanel.Dock="Bottom" x:Name="Status" Style="{StaticResource Caption}" Text="未开启采集或输出" MaxHeight="28"/>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="‹ 返回" Click="Back" Margin="0,0,6,0"/>
      <ComboBox Grid.Column="1" Margin="0" SelectedIndex="0" AutomationProperties.Name="输出目标"><ComboBoxItem Content="OBS Virtual Camera"/></ComboBox>
      <Button Grid.Column="2" Content="重新加载" Click="Reload" Margin="6,0,0,0"/>
    </Grid>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ComboBox x:Name="PersonChoice" Margin="0" SelectionChanged="EffectsChanged" AutomationProperties.Name="人物选择"/>
      <ComboBox x:Name="BackgroundChoice" Grid.Column="2" Margin="0" SelectionChanged="EffectsChanged" AutomationProperties.Name="背景选择"/>
    </Grid>
    <Border Style="{StaticResource Card}" Padding="1" Margin="0"><wv:WebView2 x:Name="Browser"/></Border>
  </DockPanel>
</Window>
