<Window x:Class="CallBridge.Windows.TextWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="文字输入" Width="560" Height="112" MinWidth="180" MinHeight="96">
  <DockPanel Margin="12,3,12,6">
    <TextBlock x:Name="Status" Style="{StaticResource Caption}" DockPanel.Dock="Bottom" Text="尚未发送" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="2,3,2,0"/>
    <Border x:Name="Details" Style="{StaticResource Card}" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,8,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="语音音量" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/><Slider Grid.Column="1" x:Name="Gain" Minimum="0" Maximum="1" ValueChanged="GainChanged" AutomationProperties.Name="语音音量"/><TextBlock Grid.Column="2" x:Name="GainLabel" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
        <WrapPanel Margin="0,8,0,0"><Button x:Name="PreviewButton" Content="试听这段" Click="Preview" Margin="0,0,8,6"/><Button x:Name="PrepareButton" Content="准备语音" Click="Prepare" Margin="0,0,8,6"/><Button x:Name="CountdownButton" Content="5 秒后播放" Click="Countdown" Margin="0,0,0,6"/></WrapPanel>
        <CheckBox x:Name="Permission" Content="允许向所选设备发送" Margin="0,4,0,8" Checked="PermissionChanged" Unchecked="PermissionRevoked"/>
        <DockPanel><Button Content="音频设置" Click="Settings" HorizontalAlignment="Left"/><CheckBox x:Name="Pin" Content="面板置顶" Click="PinChanged" HorizontalAlignment="Right"/></DockPanel>
      </StackPanel></ScrollViewer>
    </Border>
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0"><Button x:Name="SendButton" Content="↑" ToolTip="发送 · Ctrl+Enter" AutomationProperties.Name="发送" Width="30" Padding="0" Click="Send" Style="{StaticResource PrimaryButton}"/><Button Content="■" ToolTip="停止 · Ctrl+." AutomationProperties.Name="停止" Width="30" Padding="0" Click="Stop" Margin="4,0,0,0"/><Button Content="⌄" ToolTip="展开" AutomationProperties.Name="展开或收起" Width="30" Padding="0" Click="Expand" x:Name="ExpandButton" Margin="4,0,0,0"/></StackPanel>
      <TextBox x:Name="Editor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="17" Padding="8,4" TextChanged="DraftChanged" AutomationProperties.Name="待发送文字"/>
    </DockPanel>
  </DockPanel>
</Window>
