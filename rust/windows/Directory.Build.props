<Project>
  <!-- 中间产物集中到现有 build 目录，避免在源码旁生成 obj/bin。 -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\build\windows\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\build\windows\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
