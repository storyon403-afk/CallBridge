<?xml version="1.0" encoding="UTF-8"?>
<!--
本文件的目的：告诉 macOS 这个 App 的身份、启动文件和系统版本要求。
为什么独立于代码？Finder、应用启动和签名工具读取的是 bundle 元数据，不会扫描 main 函数。
麦克风仅用于用户主动选择的环境音混合；权限说明不等于启动时自动请求或开启采集。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 可执行文件名要与 Contents/MacOS/ 下的构建产物一致。 -->
    <key>CFBundleExecutable</key><string>CallBridge</string>
    <key>CFBundleIdentifier</key><string>dev.callbridge.demo</string>
    <key>CFBundleDevelopmentRegion</key><string>zh-Hans</string>
    <key>CFBundleLocalizations</key><array><string>zh-Hans</string><string>en</string><string>ja</string></array>
    <key>CFBundleName</key><string>CallBridge</string>
    <key>CFBundleIconFile</key><string>CallBridge.icns</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <!-- 对外版本号与内部构建号分开；不能把构建号理解成系统版本。 -->
    <key>CFBundleShortVersionString</key><string>0.12.0</string>
    <key>CFBundleVersion</key><string>28</string>
    <key>CFBundleURLTypes</key>
    <array><dict>
        <key>CFBundleURLName</key><string>dev.callbridge.text</string>
        <key>CFBundleURLSchemes</key><array><string>callbridge</string></array>
        <key>CFBundleTypeRole</key><string>Editor</string>
    </dict></array>
    <key>NSMicrophoneUsageDescription</key><string>仅在你勾选环境音并确认持续发送后，立即采集所选真实麦克风；文字语音随后叠加送入通话。声音包含你的说话声，不保存录音；取消环境勾选关麦，停止关闭全部声音。</string>
    <key>NSCameraUsageDescription</key><string>仅在你点击开启摄像头后，在本机跟踪表情与动作并驱动虚拟形象。不录制或上传；视频输出需另行点击，关闭画面窗口停止采集。</string>
    <!-- 与 build-app.sh 的部署目标一致，不靠修改这个字符串就获得旧系统兼容性。 -->
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
</dict>
</plist>
