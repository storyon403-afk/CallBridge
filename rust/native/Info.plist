<?xml version="1.0" encoding="UTF-8"?>
<!--
本文件的目的：告诉 macOS 这个 App 的身份、启动文件和系统版本要求。
为什么独立于代码？Finder、应用启动和签名工具读取的是 bundle 元数据，不会扫描 main 函数。
麦克风仅用于用户主动选择的环境音混合；权限说明不等于启动时自动请求或开启采集。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 可执行文件名要与 Contents/MacOS/ 下的构建产物一致。 -->
    <key>CFBundleExecutable</key><string>CallBridge</string>
    <key>CFBundleIdentifier</key><string>dev.callbridge.demo</string>
    <key>CFBundleName</key><string>CallBridge</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <!-- 对外版本号与内部构建号分开；不能把构建号理解成系统版本。 -->
    <key>CFBundleShortVersionString</key><string>0.4.0</string>
    <key>CFBundleVersion</key><string>8</string>
    <key>NSMicrophoneUsageDescription</key><string>仅在你启用环境音并点击发送后，采集所选真实麦克风，与文字语音混合送入通话。声音包含你的说话声；不保存录音，点击停止即可关闭。</string>
    <!-- 与 build-app.sh 的部署目标一致，不靠修改这个字符串就获得旧系统兼容性。 -->
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
</dict>
</plist>
